context platform=android timeout=900000

# P0-08 Path A complete in field with GPS and local finalization.
# Converted from .maestro/p0/08-path-a-complete-in-field-gps.yaml.
#
# Prerequisites: authenticated field reporter, reachable Metro, and a fresh
# development build with expo-location. The emulator must provide an
# acceptable foreground GPS reading for this path.
#
# Preflow: npm run e2e:env stages the Rust fixture (replacing addMedia) and
# grants location; scripts/ad-flow-env.sh grant-permissions re-asserts the
# allow state mid-flow where the original used setPermissions allow. The
# "Don't allow" branch of the original is not needed because the initial
# GPS attempt resolves without a system dialog under the preflow contract.

open "com.niks0501.caneguard" --relaunch --platform android
# Cold start requires explicit authentication (auth security change:
# the app requires unlock on restart). Sign in with the field account.
wait "label=\"Welcome back\"" 120000
fill "id=\"auth.email-input\"" "${AUTH_EMAIL}"
fill "id=\"auth.password-input\"" "${AUTH_PASSWORD}"
click "id=\"auth.login-submit\""
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///scan" --platform android
wait "id=scan.screen" 30000
click "id=scan.choose-gallery"
wait stable 2000 15000
find "Photo taken on" click --first
wait "id=scan.preview-screen" 30000
click "id=scan.analyze-image"
wait "id=scan.symptom-checklist-screen" 120000
click "id=scan.symptom-rust"
click "id=scan.continue-to-result"
wait "label=\"Possible result: Rust\"" 30000
scroll down 1 --settle
wait "id=scan.keep-as-scan-only" 10000
scroll down 1 --settle
wait "id=scan.keep-as-scan-only" 10000
click "id=scan.keep-as-scan-only"
wait "id=scan.record-saved" 30000
click "id=scan.open-saved-record"
wait "id=records.details-screen" 30000
scroll down 1 --settle
wait "id=records.open-field-report" 10000
scroll down 1 --settle
wait "id=records.open-field-report" 10000
click "id=records.open-field-report"
wait "id=field-report.screen" 30000
scroll down 1 --settle
wait "id=field-report.farmer-name-input" 10000
scroll down 1 --settle
wait "id=field-report.farmer-name-input" 10000
fill "id=field-report.farmer-name-input" "P0 GPS Farmer"
back --settle
click "id=field-report.barangay-input"
fill "id=field-report.barangay-input" "Wawa"
back --settle
scroll down 1 --settle
wait "id=field-report.barangay-input-option" 10000
scroll down 1 --settle
wait "id=field-report.barangay-input-option" 10000
find "Wawa" click --first
scroll down 1 --settle
wait "id=field-report.affected-area-input" 10000
scroll down 1 --settle
wait "id=field-report.affected-area-input" 10000
fill "id=field-report.affected-area-input" "1.5"
back --settle
scroll down 1 --settle
wait "id=field-report.affected-portion-input" 10000
scroll down 1 --settle
wait "id=field-report.affected-portion-input" 10000
fill "id=field-report.affected-portion-input" "30"
back --settle
scroll down 1 --settle
wait "id=field-report.save-draft" 10000
scroll down 1 --settle
wait "id=field-report.save-draft" 10000
click "id=field-report.save-draft"
scroll down 1 --settle
wait "id=field-report.saved" 30000
# Location capture remounts the report from SQLite. Persist the entered
# fields before the GPS transition so the route cannot discard them.
scroll up 1 --settle
wait "id=field-report.capture-gps" 10000
scroll up 1 --settle
wait "id=field-report.capture-gps" 10000
click "id=field-report.capture-gps"
wait "label=\"GPS location resolved\"" 60000
is visible "id=field-report.gps-evidence"
scroll up 1 --settle
wait "id=field-report.finalize" 10000
scroll up 1 --settle
wait "id=field-report.finalize" 10000
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/p0-08-path-a-ready-to-finalize.png"
click "id=field-report.finalize"
scroll up 1 --settle
wait "id=field-report.authoring-status" 30000

close
