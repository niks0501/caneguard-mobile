{
  "name": "caneguard-mobile",
  "main": "expo-router/entry",
  "version": "2.2.1",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "base64-js": "^1.5.1",
    "drizzle-orm": "0.45.2",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "geographiclib-geodesic": "2.2.0",
    "jpeg-js": "^0.4.4",
    "jsts": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/jpeg-js": "^0.3.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "3.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "node ./scripts/start-dev-client.js",
    "reset-project": "node ./scripts/reset-project.js",
    "graphify:refresh": "node ./scripts/graphify-refresh.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:validate": "node ./scripts/web-validate.js",
    "lint": "expo lint",
    "pretypecheck": "node ./scripts/generate-expo-router-types.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify:fast": "npm run lint && npm run typecheck && npm test -- --runInBand",
    "qa:config": "node ./scripts/validate-qa-env.js --config-only",
    "qa:preflight": "node ./scripts/validate-qa-env.js --require-qa",
    "qa:export": "node ./scripts/qa-export.js",
    "security:config": "node ./scripts/validate-security-config.js",
    "eas-build-pre-install": "node ./scripts/validate-qa-env.js && node ./scripts/validate-security-config.js --eas",
    "test:coverage": "jest --coverage",
    "e2e": "agent-device test .agent-device/flows",
    "e2e:flow": "agent-device replay",
    "e2e:doctor": "agent-device doctor",
    "e2e:env": "bash scripts/ad-flow-env.sh preflight"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|jsts))/",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "<rootDir>/caneguard-web/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.tflite$": "<rootDir>/test/__mocks__/fileMock.js"
    },
    "resolver": "react-native-reanimated/jest/resolver"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite"
        ]
      }
    }
  },
  "private": true
}
