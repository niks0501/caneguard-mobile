context platform=android timeout=240000

# INTENT: The reporter retrieves the office-created assignment for their own
# submitted case, and sees the owner/validator relationship before a visit.
# Converted from .maestro/t10/02-mobile-owner-assignment-retrieval.yaml.
# Precondition: Web explicit review assigned T10_CASE_REFERENCE to AUTH_EMAIL.
# See the cross-surface fixture procedure in ../../evidence/INTENT-REPLAY.md.

open "com.niks0501.caneguard" --relaunch --platform android
wait "label=\"Welcome back\"" 120000
fill "id=auth.email-input" "${AUTH_EMAIL}"
fill "id=auth.password-input" "${AUTH_PASSWORD}"
click "id=auth.login-submit"
wait "id=home.screen" 120000
click "label=\"My Activity\""
wait "id=activity.screen" 30000
wait "role=button label=\"Refresh notifications\"" 30000
# The office's newest assignment notification is a stable entry point even
# when older notifications push the timeline and refresh controls offscreen.
click "role=button label=\"Refresh notifications\""
wait "role=button label=\"Field validation assigned: ${T10_CASE_REFERENCE} was assigned to you for field validation.\"" 60000
click "role=button label=\"Field validation assigned: ${T10_CASE_REFERENCE} was assigned to you for field validation.\""
wait "id=field-validation.screen" 30000
is visible "id=field-validation.assignment-summary"
is visible "label=\"${T10_CASE_REFERENCE}\""
is visible "label=\"You submitted this case and are its validator.\""
close
