context platform=android timeout=900000

# Auth v1 password reset deep link revokes sessions.
# Converted from .maestro/auth-v1/08-password-reset-deep-link.yaml.
#
# Precondition (ordered segment): run 07-password-recovery-request.ad,
# take the latest local reset link from the disposable API log, and hand
# it to the installed app before running this script. Never record the
# one-time link or token anywhere.
#
# AUTH_NEW_PASSWORD is the new local passphrase; after this flow the
# field account's password is AUTH_NEW_PASSWORD.

# Establish the replay session without relaunching so the handed-off route is preserved.
open "com.niks0501.caneguard" --platform android
wait "id=reset-password.password-input" 60000
fill "id=reset-password.password-input" "${AUTH_NEW_PASSWORD}"
click "id=reset-password.submit"
wait "id=reset-password.success" 30000
is visible "label=\"Password updated\""
click "label=\"Return to login\""
wait "id=auth.login-screen" 30000
fill "id=auth.email-input" "${AUTH_EMAIL}"
fill "id=auth.password-input" "${AUTH_NEW_PASSWORD}"
click "id=auth.login-submit"
wait "id=home.screen" 120000
wait "label=\"Start Scan\"" 30000
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/auth-v1-password-reset-deep-link.png"

close
