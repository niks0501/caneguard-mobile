context platform=android timeout=900000

# P0-02 incomplete Field Report Draft survives restart.
# Converted from .maestro/p0/02-draft-report-lifecycle.yaml.
#
# Preflow: npm run e2e:env (stages the Rust fixture, replacing the Maestro
# addMedia command). The flow preserves application state and requires an
# authenticated field-reporter session.
#
# Behavior note: the original flow conditionally tapped "Don't allow" on the
# system location prompt raised by the new Draft's automatic GPS attempt.
# With scripts/ad-flow-env.sh preflight the permission state is pre-granted,
# and location-denied variants run revoke-permissions first; in both cases
# the request resolves without the system dialog, so the branch is gone.

open "com.niks0501.caneguard" --relaunch --platform android
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///scan" --platform android
wait "id=scan.screen" 30000
click "id=scan.choose-gallery"
wait "label=\"Photo taken on\"" 15000
find "Photo taken on" click --first
click "label=Done"
wait "id=scan.preview-screen" 30000
click "id=scan.analyze-image"
wait "id=scan.symptom-checklist-screen" 120000
click "id=scan.symptom-rust"
click "id=scan.continue-to-result"
wait "label=\"Possible result: Rust\"" 30000
scroll down --settle
wait "id=scan.keep-as-scan-only" 10000
scroll down --settle
wait "id=scan.keep-as-scan-only" 10000
click "id=scan.keep-as-scan-only"
wait "id=scan.record-saved" 30000
click "id=scan.open-saved-record"
wait "id=records.details-screen" 30000
scroll down --settle
wait "id=records.open-field-report" 10000
scroll down --settle
wait "id=records.open-field-report" 10000
click "id=records.open-field-report"
wait "id=field-report.screen" 30000
scroll down --settle
wait "id=field-report.farmer-name-input" 10000
scroll down --settle
wait "id=field-report.farmer-name-input" 10000
fill "id=field-report.farmer-name-input" "P0 Draft Farmer"
back --settle
scroll down --settle
wait "id=field-report.save-draft" 10000
scroll down --settle
wait "id=field-report.save-draft" 10000
click "id=field-report.save-draft"
scroll down --settle
wait "id=field-report.saved" 30000
scroll up --settle
wait "id=field-report.saved" 10000
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/p0-02-draft-saved.png"
open "com.niks0501.caneguard" --relaunch --platform android
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///activity" --platform android
wait "id=activity.screen" 30000
scroll down --settle
wait "id=records.details-screen" 30000
scroll down --settle
wait "id=records.open-field-report" 10000
scroll down --settle
wait "id=records.open-field-report" 10000
is visible "label=\"Resume Draft\""
click "id=records.open-field-report"
wait "id=field-report.screen" 30000
is visible "label=Draft"
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/p0-02-draft-reopened.png"

close
