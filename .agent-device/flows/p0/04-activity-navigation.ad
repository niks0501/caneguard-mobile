context platform=android timeout=900000

# INTENT: Find both synchronized reports and scan-only observations in
# Activity, open their details, and return without losing filter navigation.
# Converted from .maestro/p0/04-activity-navigation.yaml.
#
# Prerequisites (unchanged from the Maestro original, performed outside the
# flow): a current Android development build and matching Metro bundle; an
# authenticated field reporter session; at least one saved scan-only
# observation; and at least one synchronized Field Report owned by the
# signed-in reporter. The flow preserves application state and does not add
# credentials or fixtures.
#
# Conversion note: the Maestro launchApp command restarts the app process;
# --relaunch preserves that semantic so the app boots to its initial route.

open "com.niks0501.caneguard" --relaunch --platform android
# Cold start requires explicit authentication (auth security change:
# the app requires unlock on restart). Sign in with the field account.
wait "label=\"Welcome back\"" 120000
fill "id=\"auth.email-input\"" "${AUTH_EMAIL}"
fill "id=\"auth.password-input\"" "${AUTH_PASSWORD}"
click "id=\"auth.login-submit\""
wait "id=home.screen" 120000
click "id=nav.activity"
wait "id=activity.screen" 30000
# The screen test ID is the stable Activity assertion; the title is not a label on Android.
is visible "id=activity.screen"
wait stable 1000 10000
scroll down 0.25 --settle
is visible "id=activity.filter.all"
is visible "id=activity.filter.reports"
is visible "id=activity.filter.scans"
# Fractional scrolling exposes filters and newest records together.
is visible "id=activity.timeline"
click "id=activity.latest-record"
wait "id=records.details-screen" 30000
is visible "id=records.result-title"
back --settle
wait "id=activity.screen" 30000
click "id=activity.filter.reports"
wait "id=activity.screen" 30000
click "id=activity.latest-record"
wait "id=records.details-screen" 30000
back --settle
wait "id=activity.screen" 30000
click "id=activity.filter.scans"
wait "id=activity.screen" 30000
find "scan saved" click --first
wait "id=records.details-screen" 30000
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/t04-activity-navigation-and-discovery.png"

close
