context platform=android timeout=240000

# INTENT: Accept both immediate GPS reporting and saved-Draft/manual-map
# reporting, including the Draft's authenticated restart and final sync.
# Converted from .maestro/p0/08-end-to-end-acceptance.yaml.
# REQUIRED entry point: node .agent-device/checks/p0-acceptance.mjs runs
# Path A, the denied-GPS Draft producer, Path B, then this final assertion.
# This last segment alone is NOT end-to-end acceptance.

open "com.niks0501.caneguard" --platform android
wait "label=\"Finalized · Synced\"" 30000
is visible "label=\"P0 Draft Farmer\""
is visible "label=\"Manual map\""
is visible "label=\"Server report UUID\""
is visible "label=\"Last synchronized\""
close
