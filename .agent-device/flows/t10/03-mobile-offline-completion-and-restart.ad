context platform=android timeout=900000

# T10 stages 8-9 - offline field validation completion and restart
# preservation. Converted from .maestro/t10/03-mobile-offline-completion-and-restart.yaml.
#
# Preflow: scripts/ad-flow-env.sh grant-permissions (location allow,
# replacing the Maestro setPermissions command). The setClipboard/pasteText
# entries become fill commands. Preconditions: airplane mode enabled on the
# emulator (network off) and the T10 case from stage 7 open or retrievable.
# ${T10_CASE_REFERENCE} identifies the seeded case. After the flow, restore
# the emulator network.

open "com.niks0501.caneguard" --relaunch --platform android
wait "id=home.screen" 120000
is visible "label=Offline"
click "label=\"My Activity\""
wait "id=activity.screen" 30000
scroll down --settle
wait "label=\"Field validation assignment ${T10_CASE_REFERENCE}\"" 60000
scroll down --settle
wait "label=\"Field validation assignment ${T10_CASE_REFERENCE}\"" 60000
click "label=\"Field validation assignment ${T10_CASE_REFERENCE}\""
wait "id=field-validation.screen" 30000
scroll down --settle
wait "id=field-validation.observation-input" 10000
scroll down --settle
wait "id=field-validation.observation-input" 10000
fill "id=field-validation.observation-input" "T10 leaves show localized orange-brown pustules without stem lodging."
back --settle
scroll down --settle
wait "id=field-validation.finding-input" 10000
scroll down --settle
wait "id=field-validation.finding-input" 10000
fill "id=field-validation.finding-input" "T10 field evidence is consistent with rust symptoms and remains separate from the AI result."
back --settle
scroll down --settle
wait "id=field-validation.action-input" 10000
scroll down --settle
wait "id=field-validation.action-input" 10000
fill "id=field-validation.action-input" "T10 advised isolation, monitoring, and office review before any final disposition."
back --settle
scroll down --settle
wait "id=field-validation.complete" 10000
scroll down --settle
wait "id=field-validation.complete" 10000
click "id=field-validation.complete"
wait "label=\"Saved on this device\"" 60000
is visible "label=\"The completed evidence is preserved locally and will retry automatically when connectivity returns.\""
is visible "label=\"Visit time\""
is visible "label=GPS"
is visible "id=field-validation.retry"
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/t10-08-mobile-offline-completion-pending.png"
open "com.niks0501.caneguard" --relaunch --platform android
wait "id=home.screen" 120000
is visible "label=Offline"
click "label=\"My Activity\""
wait "id=activity.screen" 30000
scroll down --settle
wait "label=\"Field validation assignment ${T10_CASE_REFERENCE}\"" 60000
scroll down --settle
wait "label=\"Field validation assignment ${T10_CASE_REFERENCE}\"" 60000
click "label=\"Field validation assignment ${T10_CASE_REFERENCE}\""
wait "id=field-validation.screen" 30000
is visible "label=${T10_CASE_REFERENCE}"
scroll down --settle
wait "label=\"Saved on this device\"" 10000
scroll down --settle
wait "label=\"Saved on this device\"" 10000
is visible "label=\"Visit time\""
is visible "id=field-validation.retry"
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/t10-09-mobile-pending-after-restart.png"

close
