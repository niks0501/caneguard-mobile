context platform=android timeout=240000

# INTENT: Complete a report immediately in the field with a valid GPS reading
# rather than manual coordinates, and synchronize the completed observation.
# Converted from .maestro/p0/08-path-a-complete-in-field-gps.yaml.
# Preflow: stage-media + grant-permissions; emulator GPS must resolve <=5m.

open "com.niks0501.caneguard" --relaunch --platform android
wait "label=\"Welcome back\"" 120000
fill "id=auth.email-input" "${AUTH_EMAIL}"
fill "id=auth.password-input" "${AUTH_PASSWORD}"
click "id=auth.login-submit"
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///scan" --platform android
wait "id=scan.screen" 30000
click "id=scan.choose-gallery"
wait stable 2000 15000
find "Photo taken on" click --first
wait "id=scan.preview-screen" 30000
click "id=scan.analyze-image"
wait "id=scan.symptom-checklist-screen" 120000
click "id=scan.symptom-rust"
click "id=scan.continue-to-result"
wait "label=\"Possible result: Rust\"" 30000
scroll down 0.5 --settle
wait "id=scan.report-to-office" 10000
click "id=scan.report-to-office"
wait "id=field-report.screen" 30000
wait "id=field-report.minimum-requirements" 30000
is visible "id=field-report.summary"
scroll down 0.25 --settle
wait "id=field-report.observed-at" 10000
is visible "id=field-report.submitter"
scroll down 0.25 --settle
fill "id=field-report.farmer-name-input" "P0 GPS Farmer"
click "role=button label=\"Barangay\""
fill "label=\"Search barangay\"" "Wawa"
# fill uses the hidden test IME. Back would leave the form; dismiss is not
# needed. Expose the filtered option below the inline picker instead.
scroll down 0.25 --settle
click "role=button label=\"Wawa\""
fill "id=field-report.affected-area-input" "1.5"
fill "id=field-report.affected-portion-input" "30"
# Leave room for the possible-recent-match notice on repeated fixture runs.
scroll down 0.5 --settle
wait "id=field-report.gps-status" 10000
is visible "id=field-report.gps-evidence"
click "id=field-report.finalize"
wait "label=\"Server report UUID\"" 120000
is visible "label=\"Last synchronized\""
# Semantic scroll-up targets the outer Android wrapper and does not move
# this nested view. Screenshot-grounded fling inside the report content.
swipe 530 650 530 1800
wait "label=\"Finalized · Synced\"" 30000
is visible "label=\"P0 GPS Farmer\""
is visible "label=\"1.5 ha\""
is visible "label=\"30%\""
is visible "label=GPS"
close
