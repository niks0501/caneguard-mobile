{
  "$id": "https://github.com/niks0501/caneguard-web/blob/main/docs/contracts/mobile-field-validation-assignment-v1.json",
  "artifact_format": "caneguard-json-contract",
  "contract": "mobile-field-validation-assignment-v1",
  "version": 1,
  "wire": {
    "method": "GET",
    "path": "/api/v1/mobile/assignments",
    "content_type": "application/json",
    "undeclared_fields": "ignored"
  },
  "envelope": {
    "required_keys": ["data", "links", "meta", "sync"],
    "data_key": "data",
    "next_link": "links.next",
    "checkpoint": "sync.before"
  },
  "fields": {
    "uuid": { "type": "uuid", "required": true, "nullable": false },
    "report_uuid": { "type": "uuid", "required": true, "nullable": false },
    "report_client_uuid": { "type": "uuid", "required": true, "nullable": false },
    "reference_code": { "type": "string", "required": true, "nullable": false, "max_length": 32 },
    "submitter": {
      "type": "object",
      "required": true,
      "nullable": false,
      "required_keys": ["uuid", "name"],
      "additional_properties": false,
      "properties": {
        "uuid": { "type": "uuid", "required": true, "nullable": false },
        "name": { "type": "string", "required": true, "nullable": false, "max_length": 255 }
      }
    },
    "assignee": {
      "type": "object",
      "required": true,
      "nullable": false,
      "required_keys": ["uuid", "name"],
      "additional_properties": false,
      "properties": {
        "uuid": { "type": "uuid", "required": true, "nullable": false },
        "name": { "type": "string", "required": true, "nullable": false, "max_length": 255 }
      }
    },
    "submitter_is_assignee": { "type": "boolean", "required": true, "nullable": false },
    "target_visit_date": { "type": "string", "required": true, "nullable": true, "format": "date" },
    "field_validation_state": {
      "type": "string",
      "required": true,
      "nullable": false,
      "enum": ["unassigned", "assigned", "in_progress", "completed"]
    },
    "assigned_at": { "type": "date-time", "required": true, "nullable": false },
    "updated_at": { "type": "date-time", "required": true, "nullable": false },
    "case": {
      "type": "object",
      "required": true,
      "nullable": false,
      "required_keys": [
        "barangay",
        "province",
        "municipality",
        "farmer_or_farm_owner_name",
        "affected_area_hectares",
        "affected_portion_percent",
        "captured_at",
        "observed_at",
        "submitted_at"
      ],
      "additional_properties": false,
      "properties": {
        "barangay": { "type": "string", "required": true, "nullable": false, "max_length": 120 },
        "province": { "type": "string", "required": true, "nullable": true, "max_length": 120 },
        "municipality": { "type": "string", "required": true, "nullable": true, "max_length": 120 },
        "farmer_or_farm_owner_name": { "type": "string", "required": true, "nullable": true, "max_length": 160 },
        "affected_area_hectares": { "type": "number", "required": true, "nullable": true, "minimum": 0 },
        "affected_portion_percent": { "type": "number", "required": true, "nullable": true, "minimum": 0, "maximum": 100 },
        "captured_at": { "type": "date-time", "required": true, "nullable": false },
        "observed_at": { "type": "date-time", "required": true, "nullable": true },
        "submitted_at": { "type": "date-time", "required": true, "nullable": false },
        "predicted_label": { "type": "string", "required": false, "nullable": true, "enum": ["healthy", "mosaic", "rust", "smut"], "description": "A case born in the office may have no AI scan: this field then arrives absent or null, and the phone shows no AI section. A field-born case always carries it." },
        "confidence": { "type": "number", "required": false, "nullable": true, "minimum": 0, "maximum": 1, "description": "Absent or null together with predicted_label on an office case with no AI scan; a field-born case always carries it." },
        "origin": { "type": "string", "required": false, "nullable": true, "description": "Absent for a field-born case. `office` marks an office-born case, which carries the office projection below and may omit the AI fields; any other value is treated as field-born with no projection read." },
        "version": { "type": "number", "required": false, "nullable": false, "minimum": 0, "description": "Office projection, office-born cases only." },
        "status": {
          "type": "object",
          "required": false,
          "nullable": false,
          "required_keys": ["workflow_status", "case_state", "review_status", "updated_at"],
          "additional_properties": false,
          "description": "Office projection, office-born cases only: the office's own workflow, case, and review status.",
          "properties": {
            "workflow_status": { "type": "string", "required": true, "nullable": false },
            "case_state": { "type": "string", "required": true, "nullable": false },
            "review_status": { "type": "string", "required": true, "nullable": false },
            "updated_at": { "type": "date-time", "required": true, "nullable": false }
          }
        },
        "reporter_concern": {
          "type": "object",
          "required": false,
          "nullable": false,
          "required_keys": ["suspected_condition", "observation_text"],
          "additional_properties": false,
          "description": "Office projection, office-born cases only: the reporter's own words about the case.",
          "properties": {
            "suspected_condition": { "type": "string", "required": true, "nullable": true },
            "observation_text": { "type": "string", "required": true, "nullable": true }
          }
        },
        "photo": {
          "type": "object",
          "required": false,
          "nullable": true,
          "required_keys": ["content_type", "bytes"],
          "additional_properties": false,
          "description": "Office projection, office-born cases only: a reference to the case photo. The phone never caches photo bytes and ignores any server-provided url, building its own guarded route instead.",
          "properties": {
            "content_type": { "type": "string", "required": true, "nullable": false },
            "bytes": { "type": "number", "required": true, "nullable": false, "minimum": 0 },
            "url": { "type": "string", "required": false, "nullable": true, "description": "Ignored by the phone." }
          }
        }
      }
    },
    "previous_visit": {
      "type": "object",
      "required": false,
      "nullable": true,
      "required_keys": [
        "reference_code",
        "visited_at",
        "reporter_suspected_condition",
        "authority_classified_condition",
        "action_taken",
        "field_observation",
        "field_finding",
        "follow_up_outcome",
        "fresh_photo_available"
      ],
      "additional_properties": false,
      "properties": {
        "reference_code": { "type": "string", "required": true, "nullable": false, "max_length": 32 },
        "visited_at": { "type": "date-time", "required": true, "nullable": false },
        "reporter_suspected_condition": { "type": "string", "required": true, "nullable": true },
        "authority_classified_condition": { "type": "string", "required": true, "nullable": true },
        "action_taken": { "type": "string", "required": true, "nullable": false },
        "field_observation": { "type": "string", "required": true, "nullable": true },
        "field_finding": { "type": "string", "required": true, "nullable": true },
        "follow_up_outcome": { "type": "string", "required": true, "nullable": true, "enum": ["improved", "unchanged", "worsened", "unable_to_determine"] },
        "fresh_photo_available": { "type": "boolean", "required": true, "nullable": false }
      }
    }
  },
  "versioning": {
    "same_major_compatible_widening": [
      "adding optional response fields",
      "adding enum values while preserving existing meanings",
      "increasing documented text or numeric bounds"
    ],
    "new_major_required": [
      "removing or renaming a field",
      "changing a field type or nullability",
      "changing owner-scope or assignment-state semantics",
      "changing pagination checkpoint semantics"
    ]
  }
}
