context platform=android timeout=240000

# INTENT: Retrieve the office's real review transition and exact feedback for
# an owned synchronized report, preserving scan/submission identity.
# Converted from .maestro/p1/01-report-review-status-and-offline-cache.yaml.
# Browser prerequisite: web-review.mjs assigned the Mobile-produced case.
# SCAN_RECORD_UUID is that report's scan_record_client_uuid from the local
# fixture API/DB, not an auth token. T10_CASE_REFERENCE is its Web reference.
# Full warm-cache check: node .agent-device/checks/review-cache.mjs.
# Offline cold restart requires manual-tests/p1-review-offline-restart.md.

open "com.niks0501.caneguard" --relaunch --platform android
wait "label=\"Welcome back\"" 120000
fill "id=auth.email-input" "${AUTH_EMAIL}"
fill "id=auth.password-input" "${AUTH_PASSWORD}"
click "id=auth.login-submit"
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///field-report?scanRecordId=${SCAN_RECORD_UUID}" --platform android
wait "label=\"Finalized · Synced\"" 30000
wait stable 2000 15000
scroll down 0.35 --settle
click "id=field-report.refresh-authority-status"
wait "label=\"Field validation needed\"" 30000
is visible "label=\"${T10_CASE_REFERENCE}\""
is text "id=field-report.authority-feedback" "Intent review: visit the field and document visible symptoms."
close
