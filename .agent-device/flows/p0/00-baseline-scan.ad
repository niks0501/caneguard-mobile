context platform=android timeout=900000

# P0-00 completed scan persists and reopens.
# Converted from .maestro/p0/00-baseline-scan.yaml.
#
# Preflow: npm run e2e:env (stages the Rust fixture and grants location,
# replacing the Maestro addMedia command). The flow preserves application
# state: a valid field-reporter session must already be stored on the
# emulator. If auth.login-screen is visible, authenticate manually and rerun.

open "com.niks0501.caneguard" --relaunch --platform android
wait "id=home.screen" 120000
is visible "label=\"Start Scan\""
is visible "label=Healthy"
scroll down --settle
wait "label=Mosaic" 10000
is visible "label=Mosaic"
scroll down --settle
wait "label=Rust" 10000
is visible "label=Rust"
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
open "com.niks0501.caneguard" "caneguardmobile:///scan" --platform android
wait "id=scan.screen" 30000
click "id=scan.choose-gallery"
wait "label=\"Photo taken on\"" 15000
find "Photo taken on" click --first
click "label=Done"
wait "id=scan.preview-screen" 30000
click "id=scan.analyze-image"
wait "id=scan.symptom-checklist-screen" 120000
click "id=scan.symptom-rust"
click "id=scan.continue-to-result"
wait "label=\"Possible result: Rust\"" 30000
scroll down --settle
wait "id=scan.keep-as-scan-only" 10000
scroll down --settle
wait "id=scan.keep-as-scan-only" 10000
click "id=scan.keep-as-scan-only"
wait "id=scan.record-saved" 30000
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/p0-00-saved-result.png"
click "id=scan.open-saved-record"
wait "id=records.details-screen" 30000
is visible "label=\"Possible result: Rust\""
is visible "label=\"Local only\""
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/p0-00-reopened-record.png"

close
