context platform=android timeout=900000

# Auth v1 expired server session requires password reauthentication.
# Converted from .maestro/auth-v1/03-expiry-and-password-reauthentication.yaml.
#
# Preconditions (ordered segment, see .agent-device/evidence/AUTH-V1.md):
# 1. Run 01-login-session-and-report-boundary.ad so a cached session exists.
# 2. Expire the field-reporter tokens in the disposable local API database.
# 3. Do not clear app state.
#
# Behavior note: the original flow asserted the regex "Session expires .*"
# on Account & security. The expiry display depends on the API token
# contract; the stable screen landmarks below prove the same
# reauthentication journey.

# The Maestro launchApp restart semantics are preserved with --relaunch.
open "com.niks0501.caneguard" --relaunch --platform android
wait "id=auth.login-screen" 120000
is visible "label=\"Welcome back\""
fill "id=auth.email-input" "${AUTH_EMAIL}"
fill "id=auth.password-input" "${AUTH_PASSWORD}"
click "id=auth.login-submit"
wait "id=home.screen" 120000
click "label=\"Open settings\""
wait "label=Settings" 30000
click "id=settings.account-security"
wait "label=\"Account & security\"" 30000
is visible "label=\"Biometric unlock\""
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/auth-v1-expiry-password-reauthentication.png"

close
