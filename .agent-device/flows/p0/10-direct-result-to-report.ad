context platform=android timeout=900000

# T03 direct result to minimum Field Report submission.
# Converted from .maestro/p0/10-direct-result-to-report.yaml.
#
# Preflow: npm run e2e:env stages the Rust fixture (replacing addMedia) and
# grants location (replacing setPermissions allow). Existing app state and
# authentication are preserved.

open "com.niks0501.caneguard" --relaunch --platform android
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///scan" --platform android
wait "id=scan.screen" 30000
click "id=scan.choose-gallery"
wait "label=\"Photo taken on\"" 15000
find "Photo taken on" click --first
click "label=Done"
wait "id=scan.preview-screen" 30000
click "id=scan.analyze-image"
wait "id=scan.symptom-checklist-screen" 120000
click "id=scan.symptom-rust"
click "id=scan.continue-to-result"
wait "label=\"Possible result: Rust\"" 30000
scroll down --settle
wait "id=scan.report-to-office" 10000
scroll down --settle
wait "id=scan.report-to-office" 10000
click "id=scan.report-to-office"
wait "id=field-report.screen" 30000
wait "id=field-report.minimum-requirements" 30000
is visible "id=field-report.summary"
scroll down --settle
wait "id=field-report.observed-at" 10000
scroll down --settle
wait "id=field-report.observed-at" 10000
is visible "id=field-report.observed-at"
scroll down --settle
wait "id=field-report.submitter" 10000
scroll down --settle
wait "id=field-report.submitter" 10000
scroll up --settle
wait "label=\"Nasugbu, Batangas\"" 10000
scroll up --settle
wait "label=\"Nasugbu, Batangas\"" 10000
scroll down --settle
wait "id=field-report.farmer-name-input" 10000
scroll down --settle
wait "id=field-report.farmer-name-input" 10000
fill "id=field-report.farmer-name-input" "T03 Farm Block 12"
back --settle
click "id=field-report.barangay-input"
fill "id=field-report.barangay-input" "Wawa"
back --settle
scroll down --settle
wait "id=field-report.barangay-input-option" 10000
scroll down --settle
wait "id=field-report.barangay-input-option" 10000
find "Wawa" click --first
scroll down --settle
wait "id=field-report.affected-area-input" 10000
scroll down --settle
wait "id=field-report.affected-area-input" 10000
fill "id=field-report.affected-area-input" "1.25"
back --settle
scroll down --settle
wait "id=field-report.affected-portion-input" 10000
scroll down --settle
wait "id=field-report.affected-portion-input" 10000
fill "id=field-report.affected-portion-input" "40"
back --settle
# The report's new Draft automatically attempts one foreground GPS reading.
# No separate Save Record or Create Field Report action is needed, and a
# resolved GPS reading lets the reporter finalize directly from this form.
scroll down --settle
wait "id=field-report.gps-status" 10000
scroll down --settle
wait "id=field-report.gps-status" 10000
is visible "id=field-report.gps-status"
scroll up --settle
wait "id=field-report.finalize" 10000
scroll up --settle
wait "id=field-report.finalize" 10000
click "id=field-report.finalize"
scroll up --settle
wait "id=field-report.authoring-status" 30000
wait "label=\"Server report UUID\"" 120000
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/t03-direct-result-to-report-synced.png"

close
