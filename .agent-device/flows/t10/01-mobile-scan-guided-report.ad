context platform=android timeout=900000

# T10 stages 1-4 - Mobile scan, guided validation, Report to Office, and API
# case. Converted from .maestro/t10/01-mobile-scan-guided-report.yaml.
#
# Preflow: npm run e2e:env, plus the T10 case fixture prerequisites (owner
# account, seeded case reference in T10_CASE_REFERENCE). The Maestro
# setPermissions allow and addMedia commands are replaced by the preflight
# helper, and the setClipboard/pasteText entries become fill commands.

open "com.niks0501.caneguard" --relaunch --platform android
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///scan" --platform android
wait "id=scan.screen" 30000
click "id=scan.choose-gallery"
wait "label=\"Photo taken on\"" 15000
find "Photo taken on" click --first
click "label=Done"
wait "id=scan.preview-screen" 30000
click "id=scan.analyze-image"
wait "id=scan.symptom-checklist-screen" 120000
click "id=scan.symptom-rust"
click "id=scan.continue-to-result"
wait "label=\"Possible result: Rust\"" 30000
scroll down --settle
wait "id=scan.report-to-office" 10000
scroll down --settle
wait "id=scan.report-to-office" 10000
click "id=scan.report-to-office"
wait "id=field-report.screen" 30000
scroll down --settle
wait "id=field-report.farmer-name-input" 10000
scroll down --settle
wait "id=field-report.farmer-name-input" 10000
fill "id=field-report.farmer-name-input" "T10 Phase 1 Block"
back --settle
click "id=field-report.barangay-input"
fill "id=field-report.barangay-input" "Wawa"
back --settle
scroll down --settle
wait "id=field-report.barangay-input-option" 10000
scroll down --settle
wait "id=field-report.barangay-input-option" 10000
find "Wawa" click --first
scroll down --settle
wait "id=field-report.affected-area-input" 10000
scroll down --settle
wait "id=field-report.affected-area-input" 10000
fill "id=field-report.affected-area-input" "1.58"
back --settle
scroll down --settle
wait "id=field-report.affected-portion-input" 10000
scroll down --settle
wait "id=field-report.affected-portion-input" 10000
fill "id=field-report.affected-portion-input" "58"
back --settle
scroll down --settle
wait "id=field-report.finalize" 10000
scroll down --settle
wait "id=field-report.finalize" 10000
click "id=field-report.finalize"
scroll up --settle
wait "id=field-report.authoring-status" 30000
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/t10-04-mobile-report-finalized.png"

close
