context platform=android timeout=900000

# P0-05/06 Draft completed later with manual map and finalized.
# Converted from .maestro/p0/05-06-draft-manual-map-finalization.yaml.
#
# Precondition (unchanged): run 02-draft-report-lifecycle.ad first. It
# creates and reopens the latest incomplete report with farmer name
# "P0 Draft Farmer".
#
# Preflow: scripts/ad-flow-env.sh revoke-permissions replaces the Maestro
# setPermissions location deny (force-denied without the system dialog),
# so the "Don't allow" branch from the original is not needed.

open "com.niks0501.caneguard" --relaunch --platform android
# Cold start requires explicit authentication (auth security change:
# the app requires unlock on restart). Sign in with the field account.
wait "label=\"Welcome back\"" 120000
fill "id=\"auth.email-input\"" "${AUTH_EMAIL}"
fill "id=\"auth.password-input\"" "${AUTH_PASSWORD}"
click "id=\"auth.login-submit\""
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///activity" --platform android
wait "id=activity.screen" 30000
scroll down 1 --settle
wait "id=records.details-screen" 30000
scroll down 1 --settle
wait "id=records.open-field-report" 10000
scroll down 1 --settle
wait "id=records.open-field-report" 10000
click "id=records.open-field-report"
wait "id=field-report.screen" 30000
scroll down 1 --settle
wait "id=field-report.farmer-name-input" 10000
scroll down 1 --settle
wait "id=field-report.farmer-name-input" 10000
scroll down 1 --settle
wait "id=field-report.capture-gps" 10000
scroll down 1 --settle
wait "id=field-report.capture-gps" 10000
click "id=field-report.capture-gps"
# The permission is in the ask state, so the request raises the system
# dialog; decline it (replaces the Maestro setPermissions deny).
wait "label=\"Don't allow\"" 10000
click "label=\"Don't allow\""
wait "id=field-report.gps-status" 30000
is visible "id=field-report.open-manual-map"
click "id=field-report.open-manual-map"
wait "id=manual-map.screen" 30000
wait "id=manual-map.viewport" 30000
click "id=manual-map.viewport"
is visible "id=manual-map.pin"
scroll down 1 --settle
wait "id=manual-map.confirm" 10000
scroll down 1 --settle
wait "id=manual-map.confirm" 10000
click "id=manual-map.confirm"
scroll down 1 --settle
wait "id=field-report.manual-location" 30000
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/p0-05-manual-location-saved.png"
open "com.niks0501.caneguard" --relaunch --platform android
# Cold start requires explicit authentication (auth security change:
# the app requires unlock on restart). Sign in with the field account.
wait "label=\"Welcome back\"" 120000
fill "id=\"auth.email-input\"" "${AUTH_EMAIL}"
fill "id=\"auth.password-input\"" "${AUTH_PASSWORD}"
click "id=\"auth.login-submit\""
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///activity" --platform android
wait "id=activity.screen" 30000
scroll down 1 --settle
wait "id=records.details-screen" 30000
scroll down 1 --settle
wait "id=records.open-field-report" 10000
scroll down 1 --settle
wait "id=records.open-field-report" 10000
is visible "label=\"Resume Draft\""
click "id=records.open-field-report"
scroll down 1 --settle
wait "id=field-report.farmer-name-input" 10000
scroll down 1 --settle
wait "id=field-report.farmer-name-input" 10000
scroll down 1 --settle
wait "id=field-report.manual-location" 30000
scroll up 1 --settle
wait "id=field-report.barangay-input" 10000
click "id=field-report.barangay-input"
fill "id=field-report.barangay-input" "Lumbangan"
back --settle
scroll down 1 --settle
wait "id=field-report.barangay-input-option" 10000
scroll down 1 --settle
wait "id=field-report.barangay-input-option" 10000
find "Lumbangan" click --first
scroll down 1 --settle
wait "id=field-report.affected-area-input" 10000
scroll down 1 --settle
wait "id=field-report.affected-area-input" 10000
fill "id=field-report.affected-area-input" "2.5"
back --settle
scroll down 1 --settle
wait "id=field-report.affected-portion-input" 10000
scroll down 1 --settle
wait "id=field-report.affected-portion-input" 10000
fill "id=field-report.affected-portion-input" "40"
back --settle
scroll down 1 --settle
wait "id=field-report.finalize" 10000
scroll down 1 --settle
wait "id=field-report.finalize" 10000
click "id=field-report.finalize"
scroll up 1 --settle
wait "id=field-report.authoring-status" 30000
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/p0-05-06-manual-finalized.png"

close
