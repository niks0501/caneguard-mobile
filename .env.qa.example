# Copy to .env.qa.local for a local QA bundle check.
# Replace the placeholder with the exact QA_PUBLIC_URL from the Web/API staging host.
# The Tailscale Funnel origin must use HTTPS and must not be localhost or a loopback address.
EXPO_PUBLIC_API_BASE_URL=https://<device>.<tailnet>.ts.net
EXPO_PUBLIC_QA_MODE=true
