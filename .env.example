EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Optional crash and release-health reporting. Leave unset to keep Sentry
# disabled; the DSN is read from the build environment only and must never be
# committed. Crash events never include farmer names, GPS, or photo URIs.
# EXPO_PUBLIC_SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
# Release-build source map and native symbol upload also needs these in the
# build environment (never in this file): SENTRY_ORG, SENTRY_PROJECT, and
# SENTRY_AUTH_TOKEN.
# Release auth links require a public HTTPS hostname configured by Web/API.
# EXPO_PUBLIC_AUTH_LINK_HOST=auth.example.test
# Optional for the online manual-map fallback; leave unset to keep the map unavailable.
# After the Web/API proxy is deployed, use its HTTPS origin (the same origin as
# EXPO_PUBLIC_API_BASE_URL) and keep the {z}, {x}, and {y} placeholders intact.
# EXPO_PUBLIC_MAP_TILE_PROXY_URL=https://api.example.test/api/v1/mobile/map-tiles/{z}/{x}/{y}.png
