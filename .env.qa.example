# Copy to .env.qa.local for a local QA bundle check.
# Replace the placeholder with the exact QA_PUBLIC_URL from the Web/API staging host.
# The Tailscale Funnel origin must use HTTPS and must not be localhost or a loopback address.
# Changing the Funnel hostname requires a fresh APK when delivering an APK because this value is bundled at build time.
EXPO_PUBLIC_API_BASE_URL=https://<device>.<tailnet>.ts.net
EXPO_PUBLIC_QA_MODE=true
# Set these only when the QA Web/API host and privacy tile proxy are deployed.
# EXPO_PUBLIC_AUTH_LINK_HOST=<qa-auth-host>
# EXPO_PUBLIC_MAP_TILE_PROXY_URL=https://<device>.<tailnet>.ts.net/api/v1/mobile/map-tiles/{z}/{x}/{y}.png
