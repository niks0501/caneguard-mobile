context platform=android timeout=900000

# P0-06 complete-in-field report finalization.
# Converted from .maestro/p0/06-complete-in-field-finalization.yaml.
#
# Preflow: npm run e2e:env stages the Rust fixture (replacing addMedia) and
# scripts/ad-flow-env.sh revoke-permissions force-denies location before the
# flow (replacing setPermissions deny), so the "Don't allow" branches from
# the original are not needed and the new Draft's GPS attempt stays on the
# manual-map path.
#
# Conversion note: true Wi-Fi-off recovery remains a manual acceptance step
# because this device uses wireless ADB. The script verifies that local
# finalization is available; the separate manual procedure covers the
# radio-off path.

open "com.niks0501.caneguard" --relaunch --platform android
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///scan" --platform android
wait "id=scan.screen" 30000
click "id=scan.choose-gallery"
wait "label=\"Photo taken on\"" 15000
find "Photo taken on" click --first
click "label=Done"
wait "id=scan.preview-screen" 30000
click "id=scan.analyze-image"
wait "id=scan.symptom-checklist-screen" 120000
click "id=scan.symptom-rust"
click "id=scan.continue-to-result"
wait "label=\"Possible result: Rust\"" 30000
scroll down --settle
wait "id=scan.keep-as-scan-only" 10000
scroll down --settle
wait "id=scan.keep-as-scan-only" 10000
click "id=scan.keep-as-scan-only"
wait "id=scan.record-saved" 30000
click "id=scan.open-saved-record"
wait "id=records.details-screen" 30000
scroll down --settle
wait "id=records.open-field-report" 10000
scroll down --settle
wait "id=records.open-field-report" 10000
click "id=records.open-field-report"
wait "id=field-report.screen" 30000
scroll down --settle
wait "id=field-report.farmer-name-input" 10000
scroll down --settle
wait "id=field-report.farmer-name-input" 10000
fill "id=field-report.farmer-name-input" "P0 Complete Farmer"
back --settle
click "id=field-report.barangay-input"
fill "id=field-report.barangay-input" "Wawa"
back --settle
scroll down --settle
wait "id=field-report.barangay-input-option" 10000
scroll down --settle
wait "id=field-report.barangay-input-option" 10000
find "Wawa" click --first
scroll down --settle
wait "id=field-report.affected-area-input" 10000
scroll down --settle
wait "id=field-report.affected-area-input" 10000
fill "id=field-report.affected-area-input" "1.5"
back --settle
scroll down --settle
wait "id=field-report.affected-portion-input" 10000
scroll down --settle
wait "id=field-report.affected-portion-input" 10000
fill "id=field-report.affected-portion-input" "30"
back --settle
scroll down --settle
wait "id=field-report.save-draft" 10000
scroll down --settle
wait "id=field-report.save-draft" 10000
click "id=field-report.save-draft"
scroll down --settle
wait "id=field-report.saved" 30000
scroll up --settle
wait "id=field-report.capture-gps" 10000
scroll up --settle
wait "id=field-report.capture-gps" 10000
click "id=field-report.capture-gps"
wait "id=field-report.gps-status" 30000
scroll down --settle
wait "id=field-report.open-manual-map" 10000
scroll down --settle
wait "id=field-report.open-manual-map" 10000
click "id=field-report.open-manual-map"
wait "id=manual-map.viewport" 30000
click "id=manual-map.viewport"
is visible "id=manual-map.pin"
scroll down --settle
wait "id=manual-map.confirm" 10000
scroll down --settle
wait "id=manual-map.confirm" 10000
click "id=manual-map.confirm"
scroll down --settle
wait "id=field-report.manual-location" 30000
scroll up --settle
wait "id=field-report.finalize" 10000
scroll up --settle
wait "id=field-report.finalize" 10000
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/p0-06-ready-to-finalize.png"
click "id=field-report.finalize"
scroll up --settle
wait "id=field-report.authoring-status" 30000
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/p0-06-complete-in-field-finalized.png"

close
