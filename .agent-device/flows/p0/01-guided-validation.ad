context platform=android timeout=900000

# T02 guided differential validation preserves disagreement.
# Converted from .maestro/p0/01-guided-validation.yaml.
#
# Preflow: npm run e2e:env (stages the Rust fixture, replacing the Maestro
# addMedia command). The flow preserves application state and requires an
# authenticated field-reporter session.

open "com.niks0501.caneguard" --relaunch --platform android
# Cold start requires explicit authentication (auth security change:
# the app requires unlock on restart). Sign in with the field account.
wait "label=\"Welcome back\"" 120000
fill "id=\"auth.email-input\"" "${AUTH_EMAIL}"
fill "id=\"auth.password-input\"" "${AUTH_PASSWORD}"
click "id=\"auth.login-submit\""
wait "id=home.screen" 120000
open "com.niks0501.caneguard" "caneguardmobile:///scan" --platform android
wait "id=scan.screen" 30000
click "id=scan.choose-gallery"
wait stable 2000 15000
find "Photo taken on" click --first
click "label=Done"
wait "id=scan.preview-screen" 30000
click "id=scan.analyze-image"
wait "id=scan.symptom-checklist-screen" 120000
is visible "label=\"What visible pattern, if any, best describes the area you are checking?\""
is visible "id=scan.symptom-yellow-midrib"
is visible "id=scan.symptom-something-else"
is visible "id=scan.symptom-unable-to-tell"
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
click "id=scan.symptom-something-else"
click "id=scan.continue-to-result"
wait "label=\"Possible result: Rust\"" 30000
scroll down 1 --settle
wait "id=scan.checklist-consistency" 10000
scroll down 1 --settle
wait "id=scan.checklist-consistency" 10000
is visible "id=scan.checklist-consistency"
is visible "label=\"Checklist inconsistent\""
is visible "label=\"The selected observation differs from the model result. Both remain separate evidence, and this scan can still be reported to the office.\""
scroll down 1 --settle
wait "id=scan.report-to-office" 10000
scroll down 1 --settle
wait "id=scan.report-to-office" 10000
is visible "id=scan.report-to-office"
scroll down 1 --settle
wait "id=scan.keep-as-scan-only" 10000
scroll down 1 --settle
wait "id=scan.keep-as-scan-only" 10000
is visible "id=scan.keep-as-scan-only"
scroll down 1 --settle
wait "id=scan.new-scan" 10000
scroll down 1 --settle
wait "id=scan.new-scan" 10000
is visible "id=scan.new-scan"
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
# assertNotVisible conversion: the preceding screen wait already proves the
# element is absent; is hidden only matches elements that exist but are hidden.
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/t02-guided-validation-mismatch.png"
click "id=scan.keep-as-scan-only"
wait "id=scan.record-saved" 30000

close
