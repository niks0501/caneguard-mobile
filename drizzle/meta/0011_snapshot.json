      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "field_reports_authoring_state_check": {
          "name": "field_reports_authoring_state_check",
          "value": "\"field_reports\".\"authoring_state\" in ('draft', 'ready_for_submission', 'finalized')"
        },
        "field_reports_sync_status_check": {
          "name": "field_reports_sync_status_check",
          "value": "\"field_reports\".\"sync_status\" in ('local_only', 'pending', 'syncing', 'synced', 'failed')"
        },
        "field_reports_draft_sync_check": {
          "name": "field_reports_draft_sync_check",
          "value": "\"field_reports\".\"authoring_state\" <> 'draft' or \"field_reports\".\"sync_status\" = 'local_only'"
        },
        "field_reports_draft_submission_check": {
          "name": "field_reports_draft_submission_check",
          "value": "\"field_reports\".\"authoring_state\" <> 'draft' or \"field_reports\".\"submitted_at\" is null"
        },
        "field_reports_location_check": {
          "name": "field_reports_location_check",
          "value": "(\n        \"field_reports\".\"location_source\" is null and\n        \"field_reports\".\"final_latitude\" is null and\n        \"field_reports\".\"final_longitude\" is null and\n        \"field_reports\".\"gps_accuracy\" is null\n      ) or (\n        \"field_reports\".\"location_source\" = 'gps' and\n        \"field_reports\".\"final_latitude\" between -90 and 90 and\n        \"field_reports\".\"final_longitude\" between -180 and 180 and\n        \"field_reports\".\"gps_accuracy\" >= 0\n      ) or (\n        \"field_reports\".\"location_source\" = 'manual_map' and\n        \"field_reports\".\"final_latitude\" between -90 and 90 and\n        \"field_reports\".\"final_longitude\" between -180 and 180 and\n        \"field_reports\".\"gps_accuracy\" is null\n      )"
        },
        "field_reports_gps_attempt_check": {
          "name": "field_reports_gps_attempt_check",
          "value": "(\n        \"field_reports\".\"gps_attempt_latitude\" is null and\n        \"field_reports\".\"gps_attempt_longitude\" is null and\n        \"field_reports\".\"gps_attempt_accuracy\" is null and\n        \"field_reports\".\"gps_attempted_at\" is null\n      ) or (\n        \"field_reports\".\"gps_attempt_latitude\" between -90 and 90 and\n        \"field_reports\".\"gps_attempt_longitude\" between -180 and 180 and\n        \"field_reports\".\"gps_attempt_accuracy\" >= 0 and\n        \"field_reports\".\"gps_attempted_at\" is not null\n      )"
        },
        "field_reports_sync_attempt_count_check": {
          "name": "field_reports_sync_attempt_count_check",
          "value": "\"field_reports\".\"sync_attempt_count\" >= 0"
        },
        "field_reports_affected_area_check": {
          "name": "field_reports_affected_area_check",
          "value": "\"field_reports\".\"affected_area_hectares\" is null or \"field_reports\".\"affected_area_hectares\" > 0"
        },
        "field_reports_affected_portion_check": {
          "name": "field_reports_affected_portion_check",
          "value": "\"field_reports\".\"affected_portion_percent\" is null or (\"field_reports\".\"affected_portion_percent\" >= 0 and \"field_reports\".\"affected_portion_percent\" <= 100)"
        }
      }
    },
