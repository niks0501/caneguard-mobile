context platform=android timeout=900000

# T10 stage 10 - connectivity recovery and completion synchronization.
# Converted from .maestro/t10/04-mobile-connectivity-recovery-sync.yaml.
#
# Preconditions: network restored after stage 9's offline segment (airplane
# mode off) and the locally completed T10 case from stage 9.
# ${T10_CASE_REFERENCE} identifies the seeded case.
#
# The conditional retry tap of the original becomes a tolerant skip: when
# the completion already synchronized, the retry control is absent and the
# wait for "Validation synchronized" still proves the outcome.

open "com.niks0501.caneguard" --relaunch --platform android
wait "id=home.screen" 120000
wait "label=Online" 60000
click "label=\"My Activity\""
wait "id=activity.screen" 30000
scroll down --settle
wait "label=\"Field validation assignment ${T10_CASE_REFERENCE}\"" 60000
scroll down --settle
wait "label=\"Field validation assignment ${T10_CASE_REFERENCE}\"" 60000
click "label=\"Field validation assignment ${T10_CASE_REFERENCE}\""
wait "id=field-validation.screen" 30000
scroll down --settle
wait "id=field-validation.completion-status" 10000
scroll down --settle
wait "id=field-validation.completion-status" 10000
wait "label=\"Validation synchronized\"" 120000
is visible "label=\"The office can now review this field evidence. The case remains open and is not automatically verified or closed.\""
is visible "label=\"Visit time\""
is visible "label=GPS"
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/t10-10-mobile-connectivity-recovery-synced.png"

close
