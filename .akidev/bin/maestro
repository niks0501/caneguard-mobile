#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"

# Keep Maestro and the Android device on the same WSL-native ADB server. The
# project adb wrapper rejects Windows interop executables instead of silently
# crossing into a separate Windows ADB device registry.
export PATH="$ROOT/.akidev/bin:$PATH"
"$ROOT/.akidev/bin/adb" version >/dev/null

maestro_subcommand=""
maestro_subcommand_offset=-1
maestro_arg_offset=0
for arg in "$@"; do
  case "$arg" in
    test|hierarchy)
      maestro_subcommand="$arg"
      maestro_subcommand_offset="$maestro_arg_offset"
      break
      ;;
  esac
  ((maestro_arg_offset += 1))
done

if [[ -n "$maestro_subcommand" && "${MAESTRO_REINSTALL_DRIVER:-0}" != "1" ]]; then
  # Maestro 2.7.0 defaults to uninstalling its Android helper apps when a
  # command exits. Keep them installed so MIUI does not ask for approval on
  # every test invocation. Set MAESTRO_REINSTALL_DRIVER=1 when a fresh
  # helper install is intentionally needed.
  has_driver_option=false
  for arg in "$@"; do
    case "$arg" in
      --reinstall-driver|--no-reinstall-driver|--reinstall-driver=*)
        has_driver_option=true
        break
        ;;
    esac
  done
  if [[ "$has_driver_option" == false ]]; then
    maestro_args=("$@")
    maestro_prefix_length=$((maestro_subcommand_offset + 1))
    maestro_args=(
      "${maestro_args[@]:0:$maestro_prefix_length}"
      --no-reinstall-driver
      "${maestro_args[@]:$maestro_prefix_length}"
    )
    set -- "${maestro_args[@]}"
  fi
fi

exec "$ROOT/.akidev/tools/maestro/bin/maestro" "$@"
