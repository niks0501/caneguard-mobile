{
  "name": "caneguard-mobile",
  "main": "expo-router/entry",
  "version": "1.1.1",
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "base64-js": "^1.5.1",
    "drizzle-orm": "0.45.2",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.14",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.19",
    "expo-web-browser": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/jpeg-js": "^0.3.0",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "3.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify:fast": "npm run lint && npm run typecheck && npm run test:coverage -- --runInBand",
    "qa:config": "node ./scripts/validate-qa-env.js --config-only",
    "qa:preflight": "node ./scripts/validate-qa-env.js --require-qa",
    "qa:export": "node ./scripts/qa-export.js",
    "security:config": "node ./scripts/validate-security-config.js",
    "eas-build-pre-install": "node ./scripts/validate-qa-env.js && node ./scripts/validate-security-config.js --eas",
    "test:coverage": "jest --coverage",
    "e2e": "agent-device test .agent-device/flows",
    "e2e:flow": "agent-device replay",
    "e2e:doctor": "agent-device doctor",
    "e2e:env": "bash scripts/ad-flow-env.sh preflight"
  },
  "jest": {
    "preset": "jest-expo",
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "<rootDir>/caneguard-web/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.tflite$": "<rootDir>/test/__mocks__/fileMock.js"
    },
    "collectCoverageFrom": [
      "src/features/detection/**/*.{ts,tsx}",
      "src/app/model-smoke-test.tsx",
      "src/app/scan.tsx",
      "src/app/image-preview.tsx",
      "!**/*.d.ts"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite"
        ]
      }
    }
  },
  "private": true
}
