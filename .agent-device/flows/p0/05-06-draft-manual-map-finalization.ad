context platform=android timeout=240000

# INTENT: Return to an incomplete saved Draft, preserve its existing farmer
# detail, complete it using a manual pin after denied GPS, and prove the
# finalized report survives another password-authenticated restart.
# Converted from .maestro/p0/05-06-draft-manual-map-finalization.yaml.
# Ordered precondition: p0/02 passed with revoke-permissions; no newer report.

open "com.niks0501.caneguard" --relaunch --platform android
wait "label=\"Welcome back\"" 120000
fill "id=auth.email-input" "${AUTH_EMAIL}"
fill "id=auth.password-input" "${AUTH_PASSWORD}"
click "id=auth.login-submit"
wait "id=home.screen" 120000
click "label=\"My Activity\""
wait "id=activity.screen" 30000
wait stable 1000 10000
scroll down 0.25 --settle
click "id=activity.filter.reports"
click "id=activity.latest-record"
wait "id=records.details-screen" 30000
scroll down 0.5 --settle
click "id=records.open-field-report"
wait "label=Draft" 30000
# Set location before authoring so the map route cannot discard unsaved fields.
scroll down 0.75 --settle
click "id=field-report.open-manual-map"
wait "id=manual-map.viewport enabled=true" 60000
click "id=manual-map.viewport"
is visible "id=manual-map.pin"
click "id=manual-map.confirm"
wait "id=field-report.screen" 30000
scroll down 0.5 --settle
is text "id=field-report.farmer-name-input" "P0 Draft Farmer"
click "role=button label=\"Barangay\""
fill "label=\"Search barangay\"" "Wawa"
# fill uses the hidden test IME. Back would leave the form; dismiss is not
# needed. Expose the filtered option below the inline picker instead.
scroll down 0.25 --settle
click "role=button label=\"Wawa\""
fill "id=field-report.affected-area-input" "1.5"
fill "id=field-report.affected-portion-input" "30"
# Include space for the possible-recent-match notice on repeat runs.
scroll down 0.5 --settle
wait "id=field-report.manual-location" 10000
click "id=field-report.finalize"
wait "label=\"Server report UUID\"" 120000
is visible "label=\"Last synchronized\""
swipe 530 650 530 1800
wait "label=\"Finalized · Synced\"" 30000
is visible "label=\"Manual map\""
is visible "label=\"P0 Draft Farmer\""
open "com.niks0501.caneguard" --relaunch --platform android
wait "label=\"Welcome back\"" 120000
fill "id=auth.email-input" "${AUTH_EMAIL}"
fill "id=auth.password-input" "${AUTH_PASSWORD}"
click "id=auth.login-submit"
wait "id=home.screen" 120000
click "label=\"My Activity\""
wait "id=activity.screen" 30000
wait stable 1000 10000
scroll down 0.25 --settle
click "id=activity.filter.reports"
click "id=activity.latest-record"
wait "id=records.details-screen" 30000
scroll down 0.5 --settle
click "id=records.open-field-report"
wait "label=\"Finalized · Synced\"" 30000
is visible "label=\"P0 Draft Farmer\""
is visible "label=\"Manual map\""
is visible "label=\"Server report UUID\""
close
