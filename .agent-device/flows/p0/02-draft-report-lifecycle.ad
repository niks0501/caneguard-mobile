context platform=android timeout=240000

# INTENT: An incomplete report can be saved locally, then resumed with the
# same farmer details after process restart and password reauthentication.
# Converted from .maestro/p0/02-draft-report-lifecycle.yaml.
# Preflow: stage-media; grant-permissions for GPS or revoke-permissions for
# the ordered manual-map chain. This report intentionally lacks required fields.
# Use app-owned navigation rather than rebinding the session with deep links.

open "com.niks0501.caneguard" --relaunch --platform android --test-ime
wait "label=\"Welcome back\"" 120000
fill "id=auth.email-input" "${AUTH_EMAIL}"
fill "id=auth.password-input" "${AUTH_PASSWORD}"
click "id=auth.login-submit"
wait "id=home.screen" 120000
# PENDING device-phase re-verification: re-anchored from the removed Home quick
# action label to the bottom-nav testID after the Phase 3 Home redesign.
click "id=nav.scan"
wait "id=scan.screen" 30000
click "id=scan.choose-gallery"
wait stable 2000 15000
find "Photo taken on" click --first
wait "id=scan.symptom-checklist-screen" 30000
wait "label=\"Photo checked\"" 120000
click "id=scan.symptom-rust"
click "id=scan.continue-to-result"
wait "label=\"Possible result: Rust\"" 30000
scroll down 0.5 --settle
wait "id=scan.report-to-office" 10000
click "id=scan.report-to-office"
wait "id=field-report.screen" 30000
scroll down 0.5 --settle
fill "id=field-report.farmer-name-input" "P0 Draft Farmer"
# There is no manual Save Draft: entries are kept on the phone as you type.
# The single status line below the header confirms it (the farmer field sits on the Place step).
wait "id=field-report.form-draft-status" 30000
wait stable 1500 10000
open "com.niks0501.caneguard" --relaunch --platform android --test-ime
wait "label=\"Welcome back\"" 120000
fill "id=auth.email-input" "${AUTH_EMAIL}"
fill "id=auth.password-input" "${AUTH_PASSWORD}"
click "id=auth.login-submit"
wait "id=home.screen" 120000
click "id=nav.activity"
wait "id=activity.screen" 30000
wait stable 1000 10000
scroll down 0.25 --settle
click "id=activity.filter.reports"
click "id=activity.latest-record"
wait "id=records.details-screen" 30000
scroll down 0.5 --settle
click "id=records.open-field-report"
wait "id=field-report.form-draft-status" 30000
scroll down 0.5 --settle
is text "id=field-report.farmer-name-input" "P0 Draft Farmer"
close
