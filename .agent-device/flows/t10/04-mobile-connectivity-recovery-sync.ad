context platform=android timeout=240000

# INTENT: After offline visit completion, restore connectivity and synchronize
# that same case's field evidence for office review without closing the case.
# Converted from .maestro/t10/04-mobile-connectivity-recovery-sync.yaml.
# REQUIRED driver: t10-recovery.mjs proves offline completion first, restores
# actual network state, then runs this segment. No biometric restart required.
# The driver retries only if its current snapshot still shows a pending
# completion, preserving the original conditional retry intent.

open "com.niks0501.caneguard" --platform android
wait "id=field-validation.assignment-summary" 30000
is visible "label=\"${T10_CASE_REFERENCE}\""
wait "label=\"Validation synchronized\"" 60000
is visible "label=\"The office can now review this field evidence. The case remains open and is not automatically verified or closed.\""
# Wait for the asynchronously rendered visit metadata, as in offline completion.
wait "label=\"Visit time\"" 30000
close
