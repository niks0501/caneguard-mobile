context platform=android timeout=900000

# Auth v1 generic password recovery request.
# Converted from .maestro/auth-v1/07-password-recovery-request.yaml.
#
# Preflow: npm run e2e:env, then scripts/ad-flow-env.sh reset-app,
# with AUTH_EMAIL set to a verified local account.

open "com.niks0501.caneguard" --platform android
wait text "http://" 30000
find "http://" fill "http://127.0.0.1:8081"
click "label=\"Connect\""
wait "label=\"Continue\"" 30000
click "label=\"Continue\""
click "label=\"Close\""
wait "label=\"Get started with CaneGuard\"" 180000
click "label=\"I already have an account\""
wait "id=auth.login-screen" 30000
click "id=auth.forgot-password"
wait "id=forgot-password.email-input" 30000
fill "id=forgot-password.email-input" "${AUTH_EMAIL}"
click "id=forgot-password.submit"
wait "id=forgot-password.success" 30000
is visible "label=\"Check your email\""
screenshot --out "${AD_ARTIFACTS:-.agent-device/test-artifacts}/auth-v1-generic-password-recovery.png"

close
