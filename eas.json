{
  "cli": {
    "version": ">= 21.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "qa": {
      "extends": "preview",
      "environment": "preview",
      "channel": "qa",
      "env": {
        "EXPO_PUBLIC_QA_MODE": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
